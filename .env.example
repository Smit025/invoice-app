# Public checkout URLs. Only the two live buy links are accepted; any other
# value is ignored and the built-in live links are used.
# Monthly ($2.99/mo, variant 2238873):
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=https://myinvoicemaker.lemonsqueezy.com/checkout/buy/bd2f2883-79ba-47ec-8610-3287ee80846b?enabled=2238873
# Every 6 months ($7.99, variant 2238798):
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://myinvoicemaker.lemonsqueezy.com/checkout/buy/f1ffee5b-5cbe-4c44-ba12-1ec93b520ca2?enabled=2238798

# Server-only. Never commit real values. Paste these in Vercel / .env.local.
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=2238798
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=2238873
# LEMONSQUEEZY_WEBHOOK_SECRET=

# Entitlement store. Free Upstash Redis (Vercel Marketplace → Upstash, free tier).
# Do not choose a paid database. The integration's REST URL and token go here.
# KV_REST_API_URL and KV_REST_API_TOKEN are accepted as aliases of the same pair.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
