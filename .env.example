# Public Lemon Squeezy subscription checkout (client overlay).
# Primary Unlock Pro CTA is monthly ($4.99/mo).
#
# The URL below is a TEMPORARY fallback (the previous buy link), also used in code
# when no subscription URL is set. It is not a Live subscription variant.
# After Lemon store approval, replace it with the Live monthly subscription
# overlay/buy URL. Do not invent a new product URL.
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://myinvoicemaker.lemonsqueezy.com/checkout/buy/c3c13987-5ccc-4a5c-b260-fd7eae12baca

# Yearly subscription overlay/buy URL ($39/yr). Secondary "save" CTA.
# Leave unset until the Live yearly subscription variant exists.
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_YEARLY=https://your-store.lemonsqueezy.com/checkout/buy/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# Optional alias of the monthly subscription URL. Used only when
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL is unset.
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=https://your-store.lemonsqueezy.com/checkout/buy/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# Deprecated alias for the monthly URL (previously the one-time overlay).
# NEXT_PUBLIC_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server-only. Used by POST /api/checkout (variant-based checkout) and the webhook.
# Never commit real values. Paste these in Vercel / .env.local.
# LEMONSQUEEZY_API_KEY=ey_...
# LEMONSQUEEZY_STORE_ID=12345
# Legacy variant id. Temporary monthly fallback when VARIANT_ID_MONTHLY is unset.
# Replace with the Live monthly subscription variant id after Lemon approval.
# LEMONSQUEEZY_VARIANT_ID=67890
# Preferred monthly subscription variant id ($4.99/mo).
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=67891
# Yearly subscription variant id ($39/yr).
# LEMONSQUEEZY_VARIANT_ID_YEARLY=67892
# LEMONSQUEEZY_WEBHOOK_SECRET=whsec_...
