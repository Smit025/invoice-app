# Optional Lemon Squeezy checkout (client overlay).
# Share / overlay URL for the $48 one-time Pro variant.
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional monthly overlay URL (secondary only; primary offer is $48 one-time).
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=https://your-store.lemonsqueezy.com/checkout/buy/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# Deprecated alias for the one-time overlay URL.
# NEXT_PUBLIC_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Server-only. Used by POST /api/checkout (variant-based checkout) and the webhook.
# Never commit real values. Paste these in Vercel / .env.local.
# LEMONSQUEEZY_API_KEY=ey_...
# LEMONSQUEEZY_STORE_ID=12345
# LEMONSQUEEZY_VARIANT_ID=67890
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=67891
# LEMONSQUEEZY_WEBHOOK_SECRET=whsec_...
