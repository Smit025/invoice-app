# Live Lemon Squeezy buy links. Public — safe to expose.
# 6-month plan ($7.99 every 6 months). Code falls back to this URL when unset.
LEMONSQUEEZY_CHECKOUT_URL=https://myinvoicemaker.lemonsqueezy.com/checkout/buy/f1ffee5b-5cbe-4c44-ba12-1ec93b520ca2?enabled=2238798

# Monthly plan ($2.99/mo). Code falls back to this URL when unset.
LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=https://myinvoicemaker.lemonsqueezy.com/checkout/buy/bd2f2883-79ba-47ec-8610-3287ee80846b?enabled=2238873

# Optional aliases. Prefer the names above. The retired test buy link is ignored.
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=
# NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=
# NEXT_PUBLIC_CHECKOUT_URL=

# Server-only. Never commit real values. Paste these in Vercel / .env.local.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=2238798
# LEMONSQUEEZY_VARIANT_ID_MONTHLY=2238873
# LEMONSQUEEZY_WEBHOOK_SECRET=
